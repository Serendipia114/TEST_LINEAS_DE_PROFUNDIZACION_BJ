<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulario para elección de énfasis</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- html2pdf.js para exportar resultados -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #f8fafc;
            min-height: 100vh;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        .input-tech {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(56, 189, 248, 0.3);
            color: #e2e8f0;
            transition: all 0.3s ease;
        }
        .input-tech:focus {
            outline: none;
            border-color: #38bdf8;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
        }
        
        /* Sistema de Cuadrícula Exacta para Escala Likert */
        .likert-header { display: none; }
        .likert-row { background: rgba(255,255,255,0.02); padding: 1.2rem; border-radius: 0.5rem; margin-bottom: 0.8rem; }
        .radio-group { display: flex; justify-content: space-between; margin-top: 1rem; width: 100%; }
        .radio-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
        .mobile-label { font-size: 0.75rem; color: #94a3b8; font-family: monospace; }
        
        /* Diseño para Escritorio (Desktop) */
        @media (min-width: 768px) {
            .likert-header { 
                display: grid; 
                grid-template-columns: 3fr 1fr 1fr 1fr 1fr 1fr; 
                text-align: center; 
                color: #38bdf8; 
                font-family: monospace;
                font-size: 1rem;
                padding: 0.5rem 1rem; 
                margin-bottom: 0.5rem;
            }
            .likert-row { 
                display: grid; 
                grid-template-columns: 3fr 1fr 1fr 1fr 1fr 1fr; 
                align-items: center; 
                background: transparent; 
                padding: 0.75rem 1rem; 
                margin-bottom: 0; 
                border-bottom: 1px solid rgba(255,255,255,0.05); 
                transition: background 0.2s;
            }
            .likert-row:hover { background: rgba(255,255,255,0.02); border-radius: 0.5rem; }
            .radio-group { display: contents; } 
            .mobile-label { display: none; } 
            .radio-wrap { justify-content: center; height: 100%; }
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
    </style>
</head>
<body class="p-4 md:p-8">

    <!-- CONTENEDOR DEL FORMULARIO -->
