                            <div class="radio-wrap"><span class="mobile-label">2</span><input type="radio" name="g4" value="2" class="w-4 h-4"></div>
                            <div class="radio-wrap"><span class="mobile-label">3</span><input type="radio" name="g4" value="3" class="w-4 h-4"></div>
                            <div class="radio-wrap"><span class="mobile-label">4</span><input type="radio" name="g4" value="4" class="w-4 h-4"></div>
                            <div class="radio-wrap"><span class="mobile-label">5</span><input type="radio" name="g4" value="5" class="w-4 h-4"></div>
