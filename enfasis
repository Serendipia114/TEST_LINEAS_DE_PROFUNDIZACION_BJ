                                <label class="flex items-center space-x-3 cursor-pointer"><input type="radio" name="curso" value="901" required class="w-4 h-4 text-cyan-500 bg-gray-800 border-gray-600 focus:ring-cyan-500"><span>901</span></label>
                                <label class="flex items-center space-x-3 cursor-pointer"><input type="radio" name="curso" value="902" required class="w-4 h-4 text-cyan-500 bg-gray-800 border-gray-600 focus:ring-cyan-500"><span>902</span></label>
