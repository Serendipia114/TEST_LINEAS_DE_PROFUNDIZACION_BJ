    <script>
        let datosPdf = {};

        function evaluarFormulario(event) {
            event.preventDefault();
            const formData = new FormData(event.target);
            
            let puntosComunicacion = 0;
            let puntosGestion = 0;
            
            for(let i=1; i<=5; i++) {
                puntosComunicacion += parseInt(formData.get(`c${i}`));
                puntosGestion += parseInt(formData.get(`g${i}`));
            }
            
            puntosComunicacion *= 2; 
            puntosGestion *= 2;      
            
            let enfasisGanador = "";
            let colorGanador = "";
            
            if (puntosComunicacion > puntosGestion) {
                enfasisGanador = "COMUNICACIÓN";
                colorGanador = "#0ea5e9"; 
            } else if (puntosGestion > puntosComunicacion) {
                enfasisGanador = "GESTIÓN EMPRESARIAL";
                colorGanador = "#a855f7"; 
            } else {
                enfasisGanador = "EMPATE (AMBAS LÍNEAS)";
                colorGanador = "#10b981"; 
            }

            datosPdf = {
                nombre: formData.get('nombre'),
                edad: formData.get('edad'),
                curso: formData.get('curso'),
                jornada: formData.get('jornada'),
                eleccion: formData.get('eleccion'),
                motivo: formData.get('motivo'),
                futuro: formData.get('futuro'),
                puntosComunicacion: puntosComunicacion,
                puntosGestion: puntosGestion,
                enfasisGanador: enfasisGanador,
                colorGanador: colorGanador
            };

            document.getElementById('formContainer').classList.add('hidden');
            
            document.getElementById('resNombre').innerText = datosPdf.nombre;
            document.getElementById('enfasisSugerido').innerText = datosPdf.enfasisGanador;
            document.getElementById('enfasisSugerido').style.color = datosPdf.colorGanador;
            document.getElementById('puntosComTxt').innerText = datosPdf.puntosComunicacion;
            document.getElementById('puntosGesTxt').innerText = datosPdf.puntosGestion;
            
            const tarjetaResultados = document.getElementById('resultadoTarjeta');
            tarjetaResultados.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function descargarPDF() {
            const btn = document.getElementById('btnDescargar');
            btn.innerHTML = "Generando PDF...";
            
            // SECCIÓN CORREGIDA: Se agregó `color: #000000;` absolutamente a todas las etiquetas
            // de texto para asegurar que no se herede el color blanco del body.
            const pdfHTML = `
                <div style="background: #ffffff; color: #000000; width: 800px; max-width: 100%; box-sizing: border-box; padding: 40px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: Arial, sans-serif;">
                    
                    <div style="text-align: center; border-bottom: 2px solid #000000; padding-bottom: 20px; margin-bottom: 25px;">
                        <h1 style="color: #000000; font-size: 26px; margin: 0 0 8px 0; font-weight: bold;">REPORTE DE PERFIL VOCACIONAL</h1>
                        <p style="color: #000000; margin: 0; font-size: 16px;">Elección de Énfasis Escolar</p>
                    </div>
                    
                    <table style="width: 100%; margin-bottom: 30px; border-collapse: collapse; font-size: 15px; color: #000000;">
                        <tr>
                            <td style="padding: 10px; border-bottom: 1px solid #cbd5e1; width: 50%;"><strong>Nombre:</strong> ${datosPdf.nombre}</td>
                            <td style="padding: 10px; border-bottom: 1px solid #cbd5e1; width: 50%;"><strong>Edad:</strong> ${datosPdf.edad} años</td>
                        </tr>
                        <tr>
                            <td style="padding: 10px; border-bottom: 1px solid #cbd5e1;"><strong>Curso:</strong> ${datosPdf.curso}</td>
                            <td style="padding: 10px; border-bottom: 1px solid #cbd5e1;"><strong>Jornada:</strong> ${datosPdf.jornada}</td>
                        </tr>
                    </table>

                    <div style="margin-bottom: 35px; color: #000000;">
                        <h3 style="color: #000000; margin-bottom: 15px; font-size: 18px; font-weight: bold;">Resultados Cuantitativos (Escala Máx. 50 puntos)</h3>
                        
                        <div style="margin-bottom: 20px;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 5px; font-size: 15px;">
                                <span style="font-weight: bold; color: #000000;">Línea Comunicación</span>
                                <strong style="color: #000000;">${datosPdf.puntosComunicacion} pts</strong>
                            </div>
                            <div style="background: #e2e8f0; height: 22px; border-radius: 11px; width: 100%; border: 1px solid #94a3b8; overflow: hidden;">
                                <div style="background: #0ea5e9; height: 100%; width: ${(datosPdf.puntosComunicacion/50)*100}%;"></div>
                            </div>
                        </div>

                        <div>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 5px; font-size: 15px;">
                                <span style="font-weight: bold; color: #000000;">Línea Gestión Empresarial</span>
                                <strong style="color: #000000;">${datosPdf.puntosGestion} pts</strong>
                            </div>
                            <div style="background: #e2e8f0; height: 22px; border-radius: 11px; width: 100%; border: 1px solid #94a3b8; overflow: hidden;">
                                <div style="background: #a855f7; height: 100%; width: ${(datosPdf.puntosGestion/50)*100}%;"></div>
                            </div>
                        </div>
                    </div>

                    <div style="text-align: center; background: #f1f5f9; padding: 25px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #cbd5e1;">
                        <p style="color: #000000; margin: 0 0 10px 0; font-size: 16px; font-weight: bold;">El énfasis sugerido según sus aptitudes e intereses es:</p>
                        <h2 style="color: ${datosPdf.colorGanador}; font-size: 28px; margin: 0; font-weight: bold; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">${datosPdf.enfasisGanador}</h2>
                    </div>

                    <div style="color: #000000; font-size: 15px;">
                        <h3 style="color: #000000; border-bottom: 1px solid #cbd5e1; padding-bottom: 8px; margin-bottom: 15px; font-size: 18px; font-weight: bold;">Respuestas Cualitativas del Estudiante</h3>
                        
                        <div style="margin-bottom: 15px;">
                            <p style="margin: 0 0 5px 0; color: #000000;"><strong>¿Qué énfasis elegiría hoy?</strong></p>
                            <p style="margin: 0; padding: 12px; background: #f1f5f9; border-radius: 5px; border: 1px solid #cbd5e1; color: #000000;">${datosPdf.eleccion}</p>
                        </div>
                        
                        <div style="margin-bottom: 15px;">
                            <p style="margin: 0 0 5px 0; color: #000000;"><strong>Motivación de la elección:</strong></p>
                            <p style="margin: 0; padding: 12px; background: #f1f5f9; border-radius: 5px; border: 1px solid #cbd5e1; color: #000000;">${datosPdf.motivo}</p>
                        </div>
                        
                        <div>
                            <p style="margin: 0 0 5px 0; color: #000000;"><strong>Proyección Profesional / Ocupacional:</strong></p>
                            <p style="margin: 0; padding: 12px; background: #f1f5f9; border-radius: 5px; border: 1px solid #cbd5e1; color: #000000;">${datosPdf.futuro}</p>
                        </div>
                    </div>
                    
                    <div style="text-align: center; margin-top: 40px; color: #000000; font-size: 12px; border-top: 1px solid #cbd5e1; padding-top: 15px;">
                        Documento generado automáticamente el ${new Date().toLocaleDateString()}
                    </div>
                </div>
            `;

            const opt = {
                margin:       15,
                filename:     `Resultado_${datosPdf.nombre.replace(/\s+/g, '_')}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(pdfHTML).save().then(() => {
                btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> PDF Descargado con Éxito`;
                setTimeout(() => {
                    btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg> Volver a Descargar PDF`;
                }, 3000);
            });
        }

        function reiniciarFormulario() {
            document.getElementById('enfasisForm').reset();
            document.getElementById('resultadoTarjeta').classList.add('hidden');
            document.getElementById('formContainer').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
